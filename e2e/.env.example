# Copy to e2e/.env.local to run the signed-in end-to-end tests.
#
# An existing user in the Clerk *development* instance. The tests sign in with
# a one-time token minted through Clerk's backend API, so the account needs no
# password. Use a regular (non-admin) account: the admin tests assert that such
# a user is refused.
E2E_CLERK_USER_EMAIL=

# The Clerk keys are read from apps/web/.env.local. Set them here only if that
# file is missing:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
